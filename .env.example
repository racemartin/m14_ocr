# Copier ce fichier vers .env et renseigner les valeurs reelles.
# .env n'est jamais commite (voir .gitignore).

# --- Hugging Face Hub (upload du dataset final et du modele) ---
HF_TOKEN=

# --- Backend d'inference (Etape 4, interfaces/api) ---
# "local" (llama.cpp local) ou "distant" (endpoint vLLM distant)
MOTEUR_INFERENCE=local
URL_ENDPOINT_VLLM=
CLE_API_VLLM=
URL_LLAMACPP=http://127.0.0.1:8080
