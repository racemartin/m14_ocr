@startuml anonymiser_dataset
!include ../../_common/estilo.iuml

title Étape 1 : Diagramme de séquence\nAnonymisation RGPD du dataset pivot (cas d'usage réel, classes du code)

actor "Développeur\n(ligne de commande)" as Dev

box "interfaces/cli" #F0EEE7
  participant "anonymiser_dataset.py" as CLI
end box

box "application" #F0EEE7
  participant "AnonymiserDatasetUseCase" as UC
end box

box "infrastructure/adapters" #F0EEE7
  participant "JsonlDatasetRepository" as Repo
  participant "PresidioAnonymiseur" as Anonymiseur
end box

autonumber "<b>0."

Dev -> CLI : uv run python anonymiser_dataset.py\n~-~-dataset ... ~-~-strategie replace|mask|redact\n~-~-limite 5000|full
activate CLI

note right of CLI
  ~-~-limite (08/09/2026, decision produit) :
  mesure reelle sur les 147204 exemples du
  dataset pivot -> anonymisation complete
  ~19h (cout NLP Presidio/spaCy, pas I/O).
  Plutot que choisir entre "echantillon"
  et "complet", le champ ExemplePivot.anonymise
  rend le processus incremental/reprenable :
  chaque appel traite au plus ~-~-limite
  exemples parmi ceux encore anonymise=False,
  le reste attend un appel ulterieur.
end note

CLI -> Repo : new(chemin_dataset)
CLI -> Anonymiseur : new(strategie)
CLI -> UC : new(repository, anonymiseur, limite)

CLI -> UC : executer(envelopper_iterable=...)
activate UC

note right of CLI
  envelopper_iterable est un point d'injection
  optionnel : la CLI passe un lambda qui enveloppe
  l'iterable avec tqdm(..., desc="Anonymisation
  Presidio", total=len(a_traiter)) pour afficher une
  barre de progression, sans que le cas d'usage
  (application/) depende d'une librairie de
  presentation (tqdm), conformement a l'architecture
  hexagonale.
end note

UC -> Repo : lister(filtre={anonymise: False})
activate Repo
Repo --> UC : list[ExemplePivot] (candidats non anonymises)
deactivate Repo

alt limite is None (full) ou limite >= len(candidats)
  UC -> UC : a_traiter = candidats (tous)
else limite < len(candidats)
  UC -> UC : _echantillon_stratifie(candidats, limite)
  note right of UC
    Groupe par (type_exemple, source),
    quota proportionnel par strate
    (methode du plus grand reste),
    tirage aleatoire seede par strate
    (graine_aleatoire). Garantit que
    chaque (type_exemple, source) est
    represente dans l'echantillon, meme
    quand les strates ont des tailles
    tres differentes (ex. FrenchMedMCQA,
    595, vs UltraMedical-Preference,
    109353).
  end note
  UC --> UC : a_traiter (sous-echantillon)
end

UC -> UC : iterable = envelopper_iterable(a_traiter)
note right of UC
  Si un wrapper a ete passe, ceci active
  la barre de progression tqdm visible dans
  le terminal sur a_traiter, que ce soit
  la liste complete ou le sous-echantillon
  stratifie. Sans wrapper, c'est une identite
  (aucun effet).
end note

loop pour chaque ExemplePivot de iterable
  UC -> UC : _anonymiser_exemple(exemple)
  activate UC
  UC -> Anonymiseur : anonymiser(symptomes, langue)
  activate Anonymiseur
  Anonymiseur --> UC : ResultatAnonymisation
  deactivate Anonymiseur
  UC -> Anonymiseur : anonymiser(antecedents, langue)\n(si present)
  UC -> Anonymiseur : anonymiser(...) pour chaque\nmessage prompt/completion/chosen/rejected
  note right of UC
    dataclasses.replace(...) : nouvel
    ExemplePivot immuable, anonymise=True
  end note
  deactivate UC
  UC -> UC : ajoute exemple_anonymise a la liste
end

UC -> Repo : sauvegarder_plusieurs(exemples_anonymises)
activate Repo
note right of Repo
  07/09/2026 : bug O(n^2) corrige --
  sauvegarder() par iteration relisait/
  reecrivait tout le fichier JSONL a
  CHAQUE exemple (infaisable sur 147204
  exemples/624 Mo). sauvegarder_plusieurs
  fait la meme fusion par identifiant en
  une seule lecture/ecriture. Les exemples
  non selectionnes par ~-~-limite restent
  inchanges (anonymise=False) dans le
  fichier, prets pour un appel ulterieur.
end note
Repo -> Repo : lit le fichier JSONL, fusionne\npar identifiant, reecrit une seule fois
Repo --> UC : (écriture terminée)
deactivate Repo

UC --> CLI : nombre_traites
deactivate UC

CLI --> Dev : "N exemples anonymises (strategie=..., limite=...)"
deactivate CLI

@enduml
