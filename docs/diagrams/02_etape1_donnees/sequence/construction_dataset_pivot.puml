@startuml construction_dataset_pivot
!include ../../_common/estilo.iuml

title Étape 1 : Diagramme de séquence\nConstruction du dataset pivot (cas d'usage réel, classes du code)

actor "Développeur\n(ligne de commande)" as Dev

box "interfaces/cli" #F0EEE7
  participant "E1_03_00_construire_dataset_pivot.py" as CLI
end box

box "application" #F0EEE7
  participant "ConstruireDatasetPivotUseCase" as UC
end box

box "infrastructure/adapters" #F0EEE7
  participant "LecteurCorpusFichierLocal" as Lecteur
  participant "JsonlDatasetRepository" as Repo
end box

autonumber "<b>0."

Dev -> CLI : uv run python E1_03_00_construire_dataset_pivot.py\n~-~-source mediqal_mcqu.jsonl ~-~-corpus mediqal_mcqu\n~-~-sortie ... [~-~-taille-bloc 5000]
activate CLI

note right of CLI
  ~-~-corpus selectionne le mapper dans
  MAPPERS_PAR_CORPUS : "mediqal_oeq" ->
  mapper_mediqal, "mediqal_mcqu"/"mediqal_mcqm"
  -> mapper_mediqal_qcm (schema QCM,
  clinical_case + answer_a..e +
  correct_answers), "frenchmedmcqa" ->
  mapper_frenchmedmcqa, etc. MediQAl a
  3 fichiers/schemas ; une seule cle
  "mediqal" ne suffit plus.
end note
CLI -> CLI : mapper = MAPPERS_PAR_CORPUS[corpus]

CLI -> Lecteur : new(chemin_source, taille_bloc)
note right of Lecteur
  ~-~-taille-bloc N (07/09/2026) : lecture
  pandas par blocs de N lignes plutot
  que tout le fichier source d'un coup.
  Requis sur ultramedical_preference.jsonl
  (966 Mo, 109353 enregistrements) :
  OOM reel confirme sans cette option
  sur 5.8 Go de RAM disponibles.
end note
CLI -> Repo : new(chemin_sortie)
CLI -> UC : new(lecteur, repository)

CLI -> UC : executer(mapper)
activate UC

UC -> Lecteur : lire_enregistrements()
activate Lecteur
Lecteur --> UC : Iterator[dict]\n(par blocs de taille_bloc si fourni,\nsinon tout le fichier d'un coup)
deactivate Lecteur

loop pour chaque enregistrement brut
  UC -> UC : mapper(enregistrement)
  note right of UC
    Le use case ne connaît pas la
    structure du corpus source : le
    mapper est injecté par interfaces/cli
  end note

  alt enregistrement invalide
    UC -> UC : ignore (mapper retourne None)
  else identifiant déjà vu (doublon exact)
    UC -> UC : ajoute ExemplePivot à self.doublons\n(08/09/2026 : identifiant deterministe,\ndoublons reels trouves sur les donnees reelles)
    note right of UC
      Le premier exemple portant cet
      identifiant reste dans le pivot ;
      les suivants sont ecartes, jamais
      silencieusement perdus (archives
      par le CLI, cf. ci-dessous)
    end note
  else enregistrement valide et inédit
    UC -> UC : ajoute ExemplePivot à la liste
  end
end

UC -> Repo : sauvegarder_plusieurs(exemples_valides)
activate Repo
Repo -> Repo : sérialise chaque ExemplePivot en JSON
Repo --> UC : (écriture terminée)
deactivate Repo

UC --> CLI : nombre_exemples\n(cas_usage.doublons expose les ecartes)
deactivate UC

opt cas_usage.doublons non vide
  CLI -> CLI : ajouter_exemples_jsonl(--doublons, cas_usage.doublons)
  note right of CLI
    data/processed/doublons_supprimes.jsonl
    (defaut) : archive en mode ajout,
    jamais perdu silencieusement
  end note
end

CLI --> Dev : "N exemples pivot écrits dans ...\n(+ M doublons écartés, archivés dans ...)"
deactivate CLI

@enduml
