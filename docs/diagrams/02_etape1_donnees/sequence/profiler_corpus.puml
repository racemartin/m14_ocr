@startuml profiler_corpus
!include ../../_common/estilo.iuml

title Étape 1 : Diagramme de séquence\nProfilage d'un corpus (cas d'usage réel, classes du code)

actor "Développeur\n(ligne de commande)" as Dev

box "interfaces/cli" #F0EEE7
  participant "E1_02_profiler_corpus.py" as CLI
end box

box "application" #F0EEE7
  participant "ProfilerCorpusUseCase" as UC
end box

box "infrastructure/adapters" #F0EEE7
  participant "LecteurCorpusFichierLocal" as Lecteur
  participant "YdataProfileur" as Profileur
end box

autonumber "<b>0."

Dev -> CLI : uv run python E1_02_profiler_corpus.py\n~-~-source ... ~-~-nom ... [~-~-bloque N]
activate CLI

alt ~-~-bloque N fourni (evite l'OOM sur un gros corpus, cf. ultramedical_preference.jsonl 966 Mo)
  CLI -> Lecteur : new(chemin_source, taille_bloc=N)
  note right of CLI
    Pas de ConstruireDatasetPivotUseCase ici :
    la boucle par bloc est geree directement
    par le CLI (_profiler_par_blocs)
  end note
  CLI -> Lecteur : lire_enregistrements()
  activate Lecteur
  note right of Lecteur
    pandas(chunksize=N) : un DataFrame
    par bloc, libere avant le suivant ;
    memoire de pointe bornee par N
  end note

  loop pour chaque bloc de N enregistrements (itertools.islice)
    Lecteur --> CLI : N enregistrements (dict)
    CLI -> Profileur : profiler(bloc, "<nom>_blocNNN")
    activate Profileur
    Profileur --> CLI : RapportProfilage (du bloc)
    deactivate Profileur
    CLI -> CLI : log.PARAMETER_VALUE("bloc NNN", ...)\naffichage console
  end
  deactivate Lecteur

  note over CLI
    Limite assumee : correlations et taux
    de doublons calcules PAR BLOC, jamais
    sur la totalite du corpus
  end note
  CLI -> CLI : log.FINISH_ACTION(total, nombre_de_blocs)

else chemin par defaut (sans ~-~-bloque, corpus charge entierement)
  CLI -> Lecteur : new(chemin_source)
  CLI -> Profileur : new()
  CLI -> UC : new(lecteur, profileur)

  CLI -> UC : executer(nom_corpus)
  activate UC

  UC -> Lecteur : lire_enregistrements()
  activate Lecteur
  Lecteur --> UC : Iterator[dict] (enregistrements bruts)
  deactivate Lecteur

  UC -> Profileur : profiler(enregistrements, nom_corpus)
  activate Profileur
  Profileur -> Profileur : ydata_profiling.ProfileReport(...)
  note right of Profileur
    Rapport HTML detaille ecrit sur
    disque (data/processed/rapports_profilage/)
    en plus de la synthese structuree
    retournee ci-dessous
  end note
  Profileur --> UC : RapportProfilage
  deactivate Profileur

  UC --> CLI : RapportProfilage
  deactivate UC

  CLI -> CLI : log.PARAMETER_VALUE(enregistrements, doublons, rapport...)
end

CLI --> Dev : affichage console du/des rapport(s) de profilage
deactivate CLI

@enduml
