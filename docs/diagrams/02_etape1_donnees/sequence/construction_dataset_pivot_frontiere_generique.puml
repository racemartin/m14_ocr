@startuml construction_dataset_pivot_frontiere_generique
!include ../../_common/estilo.iuml

title Étape 1 : Diagramme de séquence\nConstruction du dataset pivot, frontière code générique / code spécifique au corpus

actor "Développeur\n(ligne de commande)" as Dev

box "interfaces/cli" #F0EEE7
  participant "construire_dataset_pivot.py" as CLI
end box

box "interfaces/cli : specifique corpus" #FCEBE6
  participant "mappers_corpus.py\n(MAPPERS_PAR_CORPUS)" as Mappers
end box

box "application" #F0EEE7
  participant "ConstruireDatasetPivotUseCase" as UC
end box

box "infrastructure/adapters" #F0EEE7
  participant "LecteurCorpusFichierLocal" as Lecteur
  participant "JsonlDatasetRepository" as Repo
end box

autonumber "<b>0."

Dev -> CLI : uv run python construire_dataset_pivot.py\n--source ... --corpus mediqal --sortie ...
activate CLI

CLI -> Lecteur : new(chemin_source)
CLI -> Repo : new(chemin_sortie)
CLI -> UC : new(lecteur, repository)

CLI -> Mappers : MAPPERS_PAR_CORPUS[corpus]
activate Mappers
note right of Mappers
  **Frontière architecturale.**
  Tout le reste de ce diagramme (CLI,
  ConstruireDatasetPivotUseCase, les
  adaptateurs) est du code générique,
  réutilisable tel quel pour n'importe
  quel autre corpus ou domaine.
  mappers_corpus.py est la SEULE pièce
  qui connaît la structure JSON concrète
  de chaque corpus (MediQAl,
  FrenchMedMCQA, MedQuAD,
  UltraMedical-Preference). Pour porter
  ce pipeline vers un domaine non médical,
  il suffirait d'écrire une nouvelle
  fonction mapper_nouveau_corpus et de
  l'enregistrer dans MAPPERS_PAR_CORPUS ;
  rien d'autre ne changerait.
end note
Mappers --> CLI : référence à la fonction mapper_mediqal
deactivate Mappers

CLI -> UC : executer(mapper_mediqal)
activate UC

UC -> Lecteur : lire_enregistrements()
activate Lecteur
Lecteur --> UC : Iterator[dict] (enregistrements bruts)
deactivate Lecteur

loop pour chaque enregistrement brut
  UC -> Mappers : mapper_mediqal(enregistrement)
  activate Mappers
  Mappers --> UC : ExemplePivot | None
  deactivate Mappers

  alt enregistrement valide
    UC -> UC : ajoute ExemplePivot à la liste
  else enregistrement incomplet
    UC -> UC : ignore (mapper retourne None)
  end
end

UC -> Repo : sauvegarder_plusieurs(exemples_valides)
activate Repo
Repo -> Repo : sérialise chaque ExemplePivot en JSON
Repo --> UC : (écriture terminée)
deactivate Repo

UC --> CLI : nombre_exemples
deactivate UC

CLI --> Dev : "N exemples pivot écrits dans ..."
deactivate CLI

@enduml
