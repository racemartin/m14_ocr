@startuml decouper_splits
!include ../../_common/estilo.iuml

title Étape 1 — Diagramme de séquence\nDécoupage train/val/test clinique (cas d'usage réel, classes du code)

actor "Développeur\n(ligne de commande)" as Dev

box "interfaces/cli" #F0EEE7
  participant "decouper_splits.py" as CLI
end box

box "application" #F0EEE7
  participant "DecouperSplitsUseCase" as UC
end box

box "infrastructure/adapters" #F0EEE7
  participant "JsonlDatasetRepository" as Repo
end box

autonumber "<b>0."

Dev -> CLI : uv run python decouper_splits.py\n~-~-dataset ... [~-~-graine 42 ~-~-proportion-val 0.10 ~-~-proportion-test 0.10]
activate CLI

CLI -> Repo : new(chemin_dataset)
CLI -> UC : new(repository, graine, proportion_val, proportion_test)

CLI -> UC : executer()
activate UC

UC -> Repo : lister(filtre={anonymise: True})
activate Repo
Repo --> UC : list[ExemplePivot] (anonymises)
deactivate Repo

UC -> UC : groupe par (type_exemple, source)
note right of UC
  08/09/2026 : decoupage stratifie, plus
  un shuffle global. Un shuffle pur
  sous-representerait les petites sources
  (ex. FrenchMedMCQA) dans test/val face
  aux grandes (ex. UltraMedical-Preference,
  ~180x plus grande) -- chaque strate est
  decoupee independamment selon les memes
  proportions, garantissant train/val/test
  representatifs de toutes les (type_exemple,
  source).
end note

loop pour chaque strate (type_exemple, source), triee
  UC -> UC : random.Random(graine).shuffle(strate)
  note right of UC
    Melange deterministe (graine fixe) :
    reproductible d'une execution a l'autre
  end note
  UC -> UC : calcule n_test = n_strate * proportion_test\ncalcule n_val = n_strate * proportion_val

  loop pour chaque exemple de la strate (ordre melange)
    UC -> UC : assigne TEST_CLINIQUE, VALIDATION\nou TRAIN selon la position\najoute a exemples_avec_split
  end
end

UC -> Repo : sauvegarder_plusieurs(exemples_avec_split)
activate Repo
note right of Repo
  08/09/2026 : meme bug O(n^2) corrige que
  dans AnonymiserDatasetUseCase --
  sauvegarder() par iteration relisait/
  reecrivait tout le fichier JSONL a
  chaque exemple. sauvegarder_plusieurs
  fait la fusion par identifiant en une
  seule lecture/ecriture.
end note
Repo -> Repo : lit le fichier JSONL, fusionne\npar identifiant, reecrit une seule fois
Repo --> UC : (écriture terminée)
deactivate Repo

note over UC
  Point de vigilance mission (cahier des charges) :
  TEST_CLINIQUE n'est jamais reutilise en entrainement
end note

UC --> CLI : decompte {train: N, validation: N, test_clinique: N}
deactivate UC

CLI --> Dev : "Repartition des splits : ..."
deactivate CLI

@enduml
