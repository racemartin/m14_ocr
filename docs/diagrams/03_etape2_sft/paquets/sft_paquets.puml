@startuml sft_paquets
!pragma layout smetana
!include ../../_common/estilo.iuml

title Étape 2 : Diagramme de paquets\nModules/classes du SFT-LoRA et leur relation à l'existant (Étape 1) : [FAIT] (réel), y compris TrlSftEntraineurAdapter et training/E2_04_sft_train.py (jamais exécutés sur GPU réel, cf. notes)

package "training\n(analogue à interfaces/cli pour l'Étape 2)\n[FAIT] écrit, jamais exécuté sur GPU réel" as TRAINING {
  class sft_train
}

package "application" as APPLICATION {
  package "use_cases" {
    class FormaterDatasetChatMLUseCase <<E2_00, FAIT>>
    class EntrainerSftUseCase <<E2_01, FAIT>>
    class AjusterBoucleHyperparametresSftUseCase <<E2_02, FAIT>>
    class SauvegarderCheckpointSftUseCase <<E2_03, FAIT>>
  }
  class "verdict_convergence\n(fonction pure)" as VerdictFn <<FAIT>>
  class "grille_hyperparametres\n(fonction pure)" as GrilleFn <<FAIT>>
}

package "domain\n(zéro dépendance externe)" as DOMAIN {
  package "model" {
    class ExemplePivot <<existant, Étape 1>>
    class ExempleFormate <<FAIT>>
    class ConfigurationQuantification <<FAIT>>
    class ConfigurationLora <<FAIT>>
    class HyperparametresEntrainement <<FAIT>>
    class MetriquesEntrainement <<FAIT>>
    class CheckpointEntraine <<FAIT>>
    enum VerdictConvergence <<FAIT>>
  }
  package "ports" {
    interface RepositoryLectureEcriture <<existant, Étape 1>>
    interface FormateurConversation <<FAIT>>
    interface EntraineurSupervise <<FAIT>>
    interface SuiviExperimentation <<FAIT>>
    class ResultatEntrainementSFT <<FAIT>>
  }
}

package "infrastructure" as INFRASTRUCTURE {
  package "adapters" {
    class JsonlDatasetRepository <<existant, Étape 1>>
    class ChatMLFormateurAdapter <<FAIT>>
    class TrlSftEntraineurAdapter <<FAIT, jamais exécuté sur GPU réel>>
    class MlflowSuiviExperimentation <<FAIT>>
    class TensorboardSuiviExperimentation <<FAIT>>
    class HfDatasetSuiviExperimentation <<FAIT>>
  }
}

package "monitoring\n(hors training/ et interfaces/cli/, cf. AGENTS.md)" as MONITORING {
  class app_suivi_entrainement <<FAIT, dashboard Streamlit>>
  class importer_mlflow_local <<FAIT, CLI locale>>
  class hf_dataset_runs <<FAIT, frontière réseau HF Hub partagée>>
}

' ----------------------------------------------------------------------
' Dependances reelles (training/E2_04_sft_train.py)
' ----------------------------------------------------------------------

sft_train ..> JsonlDatasetRepository
sft_train ..> ChatMLFormateurAdapter
sft_train ..> TrlSftEntraineurAdapter
sft_train ..> MlflowSuiviExperimentation
sft_train ..> FormaterDatasetChatMLUseCase
sft_train ..> EntrainerSftUseCase
sft_train ..> AjusterBoucleHyperparametresSftUseCase
sft_train ..> SauvegarderCheckpointSftUseCase

FormaterDatasetChatMLUseCase --> ExemplePivot
FormaterDatasetChatMLUseCase --> ExempleFormate
FormaterDatasetChatMLUseCase --> FormateurConversation
FormaterDatasetChatMLUseCase --> RepositoryLectureEcriture

EntrainerSftUseCase --> ExempleFormate
EntrainerSftUseCase --> ConfigurationLora
EntrainerSftUseCase --> HyperparametresEntrainement
EntrainerSftUseCase --> EntraineurSupervise
EntrainerSftUseCase --> SuiviExperimentation
EntrainerSftUseCase --> ResultatEntrainementSFT

AjusterBoucleHyperparametresSftUseCase --> EntrainerSftUseCase
AjusterBoucleHyperparametresSftUseCase --> VerdictFn
AjusterBoucleHyperparametresSftUseCase --> GrilleFn

VerdictFn --> MetriquesEntrainement
VerdictFn --> VerdictConvergence
GrilleFn --> HyperparametresEntrainement

SauvegarderCheckpointSftUseCase --> CheckpointEntraine
SauvegarderCheckpointSftUseCase --> RepositoryLectureEcriture

ResultatEntrainementSFT --> MetriquesEntrainement
CheckpointEntraine --> ConfigurationLora
CheckpointEntraine --> HyperparametresEntrainement
CheckpointEntraine --> MetriquesEntrainement
CheckpointEntraine --> VerdictConvergence

JsonlDatasetRepository ..|> RepositoryLectureEcriture
ChatMLFormateurAdapter ..|> FormateurConversation
TrlSftEntraineurAdapter ..|> EntraineurSupervise
MlflowSuiviExperimentation ..|> SuiviExperimentation
TensorboardSuiviExperimentation ..|> SuiviExperimentation
HfDatasetSuiviExperimentation ..|> SuiviExperimentation

sft_train ..> HfDatasetSuiviExperimentation : suivi.backend: hf_dataset

app_suivi_entrainement ..> hf_dataset_runs
importer_mlflow_local ..> hf_dataset_runs
importer_mlflow_local ..> MlflowSuiviExperimentation : reproduit les runs\ntéléchargés (sqlite:///... local)
hf_dataset_runs ..> HfDatasetSuiviExperimentation : lit le même dépôt dataset HF\n(NOM_FICHIER_METRIQUES partagé)

note bottom of RepositoryLectureEcriture
  Réutilisé pour 3 types d'entités au total :
  ExemplePivot (Étape 1), ExempleFormate et
  CheckpointEntraine (Étape 2, ci-dessus) ;
  aucune méthode ajoutée au port existant.
end note

note right of TrlSftEntraineurAdapter
  [FAIT] Écrit et vérifié SANS GPU (signatures
  trl/peft/bitsandbytes inspectées, jamais
  exécuté sur une vraie session GPU à ce jour).
  Seul module du projet qui importe trl / peft /
  bitsandbytes / unsloth / liger_kernel.
  Charge le modèle quantifié et construit
  LoraConfig dans son constructeur, jamais
  exposé au-dessus de la frontière
  domain/application (02_etapes_cas_usage.md §1).
end note

note bottom of sft_train
  [FAIT] Écrit, jamais exécuté sur GPU réel
  (pas d'Environnement B disponible à ce jour).
  Analogue de interfaces/cli/*.py pour l'Étape 1,
  mais placé dans training/ (exécuté via HF Jobs,
  cf. docs/01_environnement), pas dans
  interfaces/cli/, qui reste réservé aux scripts
  sans dépendance GPU. AUCUN Docker : HF Jobs
  fournit directement un conteneur GPU éphémère,
  sans Dockerfile propre au projet (Docker n'est
  requis qu'à l'Étape 4, cf. deploiement_etape2.puml).
end note

note bottom of MONITORING
  [FAIT] app_suivi_entrainement.py (Space
  Streamlit distant, lit le dépôt HF en vivo) et
  importer_mlflow_local.py (tourne sur la machine
  LOCALE du développeur, alimente un MLflow local
  SQLite) : deux lecteurs passifs indépendants du
  même dépôt dataset HF, jamais un serveur MLflow
  partagé (cf. deploiement_etape2.puml).
end note

@enduml
